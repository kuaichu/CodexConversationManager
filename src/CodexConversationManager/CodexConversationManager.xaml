<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        x:Name="RootWindow"
        Title="Codex 对话与项目管理器"
        Width="1260" Height="800" MinWidth="900" MinHeight="620"
        Icon="pack://application:,,,/CodexConversationManager;component/assets/app-icon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Canvas}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            ResizeBorderThickness="10"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Neutral Foundation -->
        <SolidColorBrush x:Key="Canvas" Color="#F8F9FA" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PanelMuted" Color="#F9FAFB" />
        <SolidColorBrush x:Key="PanelHover" Color="#F3F4F6" />
        <SolidColorBrush x:Key="PanelSelected" Color="#ECFDF5" />
        <SolidColorBrush x:Key="Line" Color="#E5E7EB" />
        <SolidColorBrush x:Key="LineSubtle" Color="#F3F4F6" />
        <SolidColorBrush x:Key="LineHover" Color="#CBD5E1" />
        <SolidColorBrush x:Key="Ink" Color="#111827" />
        <SolidColorBrush x:Key="Muted" Color="#4B5563" />
        <SolidColorBrush x:Key="Faint" Color="#9CA3AF" />
        <SolidColorBrush x:Key="WindowBorder" Color="#D1D5DB" />
        <SolidColorBrush x:Key="WindowTitleBarBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowTitleBarBorder" Color="#E5E7EB" />
        <SolidColorBrush x:Key="ScrollThumb" Color="#D1D5DB" />
        <SolidColorBrush x:Key="ScrollThumbHover" Color="#9CA3AF" />
        <SolidColorBrush x:Key="ScrollThumbDrag" Color="#6B7280" />
        <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputBorder" Color="#D1D5DB" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardHoverBackground" Color="#F9FAFB" />
        <SolidColorBrush x:Key="BadgeBackground" Color="#F3F4F6" />
        <SolidColorBrush x:Key="PathBadgeBackground" Color="#F9FAFB" />
        <SolidColorBrush x:Key="PathBadgeBorder" Color="#E5E7EB" />
        <SolidColorBrush x:Key="PathBadgeForeground" Color="#6B7280" />

        <!-- Primary Accent: Modern OpenAI Emerald -->
        <SolidColorBrush x:Key="Accent" Color="#10A37F" />
        <SolidColorBrush x:Key="AccentHover" Color="#0D8C6D" />
        <SolidColorBrush x:Key="AccentSoft" Color="#ECFDF5" />
        <SolidColorBrush x:Key="AccentSoftHover" Color="#D1FAE5" />
        <SolidColorBrush x:Key="AccentBorder" Color="#A7F3D0" />
        <SolidColorBrush x:Key="AccentDark" Color="#047857" />

        <!-- Subagent Accent: Modern Indigo -->
        <SolidColorBrush x:Key="SubagentAccent" Color="#6366F1" />
        <SolidColorBrush x:Key="SubagentHover" Color="#4F46E5" />
        <SolidColorBrush x:Key="SubagentSoft" Color="#F5F3FF" />
        <SolidColorBrush x:Key="SubagentBorder" Color="#DDD6FE" />
        <SolidColorBrush x:Key="SubagentText" Color="#4338CA" />

        <!-- Danger Accent: Clean Alert Red -->
        <SolidColorBrush x:Key="DangerAccent" Color="#EF4444" />
        <SolidColorBrush x:Key="DangerHover" Color="#DC2626" />
        <SolidColorBrush x:Key="DangerSoft" Color="#FEF2F2" />
        <SolidColorBrush x:Key="DangerBorder" Color="#FECACA" />
        <SolidColorBrush x:Key="DangerDark" Color="#B91C1C" />

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeSurface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="{DynamicResource PanelHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="{DynamicResource Line}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE2E2" />
                    <Setter Property="Foreground" Value="#EF4444" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FCA5A5" />
                    <Setter Property="Foreground" Value="#DC2626" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConversationNavigationButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavigationFocusSurface" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavigationFocusSurface" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="MinWidth" Value="138" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="TabHover" Margin="4,5" CornerRadius="8" Background="Transparent" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHover" Property="Background" Value="{DynamicResource PanelHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#10A37F" BlurRadius="8" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                                <Setter TargetName="Surface" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="17,0" />
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.03" />
                            </Border.Effect>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PanelHover}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource LineHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource LineSubtle}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Surface" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LangSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LangSurface" Property="Background" Value="{DynamicResource PanelHover}" />
                                <Setter TargetName="LangSurface" Property="BorderBrush" Value="{DynamicResource LineHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LangSurface" Property="Background" Value="{DynamicResource LineSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource LineSubtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionActionButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource PanelHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource LineSubtle}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource LineHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource LineHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource DangerAccent}" />
            <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FEE2E2" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FCA5A5" />
                                <Setter Property="Foreground" Value="{DynamicResource DangerHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FECACA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource LineSubtle}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#E5E7EB" />
                                <Setter Property="Foreground" Value="{DynamicResource Faint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImportChoiceRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ChoiceMark" Width="17" Height="17" CornerRadius="9" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource LineHover}" BorderThickness="1.2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Ellipse x:Name="ChoiceDot" Width="7" Height="7" Fill="White" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{DynamicResource LineHover}" />
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="{DynamicResource PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="ChoiceMark" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="ChoiceMark" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="ChoiceDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImportModeSegment" TargetType="RadioButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Background" Value="{DynamicResource PanelMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentSurface" Property="Background" Value="{DynamicResource PanelHover}" />
                                <Setter TargetName="SegmentSurface" Property="BorderBrush" Value="{DynamicResource LineHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentDark}" />
                                <Setter TargetName="SegmentSurface" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="SegmentSurface" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                                <Setter TargetName="SegmentSurface" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SegmentSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="SegmentSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource LineHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="InputSurface" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="InputSurface" Property="Background" Value="{DynamicResource InputBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectConflictItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentDark}" />
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProjectConflictComboStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0,38,0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ProjectConflictItemStyle}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="FieldSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      IsHitTestVisible="False"
                                                      RecognizesAccessKey="True" />
                                    <Path x:Name="Chevron" Width="10" Height="6" Margin="0,0,14,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="M 1 1 L 5 5 L 9 1" Stroke="#6B7280" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <ToggleButton x:Name="DropDownToggle"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  ClickMode="Press"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0">
                                    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.12" />
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="220" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldSurface" Property="BorderBrush" Value="{DynamicResource LineHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="FieldSurface" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="FieldSurface" Property="Background" Value="{DynamicResource InputBackground}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="FieldSurface" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldSurface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource LineHover}" BorderThickness="1.2">
                                <Path x:Name="Tick" Data="M 3.5 8.5 L 7.2 12 L 14.3 4.7" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="10" Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinHeight="32" SnapsToDevicePixels="True">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="ThumbSurface" Width="6" MinHeight="32" Margin="2,0" Background="{DynamicResource ScrollThumb}" CornerRadius="3" SnapsToDevicePixels="True" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource ScrollThumbDrag}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="10" Background="Transparent">
                <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinWidth="30">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="ThumbSurface" Height="6" MinWidth="30" Margin="0,2" Background="#D1D5DB" CornerRadius="3" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#9CA3AF" /></Trigger>
                                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="Background" Value="#6B7280" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProjectItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemSurface" Padding="12,10" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsBatchSelected}" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#DEF7EC" />
                                <Setter TargetName="ItemSurface" Property="BorderBrush" Value="#6EE7B7" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowSurface" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- Window Top Bar -->
            <Border Grid.Row="0" Background="{DynamicResource WindowTitleBarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="22,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Codex" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="22" FontWeight="Bold" />
                        <Border Margin="10,1,0,0" Padding="8,3" CornerRadius="6" Background="{DynamicResource BadgeBackground}">
                            <TextBlock Text="对话与项目管理器" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="Medium" />
                        </Border>
                        <TextBlock Text="v1.0.3" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="9,2,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="ThemeToggleButton" Style="{StaticResource LanguageButton}" Content="🌙" ToolTip="切换为夜间模式" Margin="0,0,8,0" />
                        <Button x:Name="LanguageButton" Style="{StaticResource LanguageButton}" Content="EN" ToolTip="切换为英文" Margin="0,0,8,0" />
                        <Border Height="32" Padding="12,0" Margin="0,0,12,0" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="16" VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="本地运行" Foreground="{DynamicResource AccentDark}" FontSize="12" FontWeight="SemiBold" LineHeight="16" VerticalAlignment="Center" TextAlignment="Center" />
                            </Grid>
                        </Border>
                        <Button x:Name="MinimizeButton" Style="{StaticResource ChromeButton}" ToolTip="最小化">
                            <Border Width="12" Height="1.4" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" ToolTip="最大化">
                            <Grid Width="16" Height="16">
                                <Border x:Name="MaximizeGlyph" Width="12" Height="12" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" BorderThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid x:Name="RestoreGlyph" Visibility="Collapsed">
                                    <Border Width="10" Height="10" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" BorderThickness="1.1" Margin="3,0,0,3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Width="10" Height="10" Background="#FFFFFF" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" BorderThickness="1.1" Margin="0,3,3,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" ToolTip="关闭">
                            <Grid Width="16" Height="16">
                                <Line X1="2" Y1="2" X2="14" Y2="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.4" />
                                <Line X1="14" Y1="2" X2="2" Y2="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.4" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Navigation Tabs Bar -->
            <Border Grid.Row="1" Background="{DynamicResource PanelMuted}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                        <Grid>
                            <Button x:Name="BackupTabButton" Style="{StaticResource TabButton}" Content="管理与备份" />
                            <Border x:Name="BackupTabIndicator" Height="3" Width="72" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                        </Grid>
                        <Grid>
                            <Button x:Name="ImportTabButton" Style="{StaticResource TabButton}" Content="导入与恢复" />
                            <Border x:Name="ImportTabIndicator" Height="3" Width="72" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Bottom" Margin="0,0,0,1" Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Work Area -->
            <Grid Grid.Row="2">
                <Grid x:Name="BackupPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="118" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Action Step Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource WindowTitleBarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <Grid Margin="18,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="330" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="1 · 选择备份内容" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ConversationBackupModeRadio" GroupName="BackupMode" Style="{StaticResource ImportModeSegment}" Content="仅对话" IsChecked="True" Margin="0,0,5,0" ToolTip="生成 .codexchat：跨项目挑选主对话，不包含项目目录" />
                                    <RadioButton x:Name="ProjectBackupModeRadio" Grid.Column="1" GroupName="BackupMode" Style="{StaticResource ImportModeSegment}" Content="项目＋对话" Margin="5,0,0,0" ToolTip="生成 .codexproject：项目目录、空目录、全部主对话和子代理对话" />
                                    <RadioButton x:Name="CleanupModeRadio" Grid.Column="2" GroupName="BackupMode" Style="{StaticResource ImportModeSegment}" Content="批量清理" Margin="5,0,0,0" ToolTip="跨项目选择并删除主对话、子代理和项目目录" />
                                </Grid>
                                <TextBlock x:Name="BackupModeHelpText" Text="仅对话备份：可跨项目勾选主对话，不包含项目文件。" Foreground="{DynamicResource AccentDark}" FontSize="11.5" Margin="1,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="2 · 选择保存位置" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,7" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackupFolderBox" Style="{StaticResource RoundTextBox}" ToolTip="迁移包会自动保存到这个文件夹" />
                                    <Button x:Name="BrowseBackupFolderButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择文件夹" Margin="9,0,0,0" MinWidth="92" />
                                </Grid>
                                <TextBlock Text="自动命名；同名时追加序号，不会覆盖旧备份。" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="1,6,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,24,0,0" VerticalAlignment="Top">
								<Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}" Content="刷新/修复" MinWidth="84" ToolTip="重新读取本地项目和对话，并检测可安全修复的侧边栏残留" />
                                <Button x:Name="TrashButton" Style="{StaticResource SecondaryButton}" Content="回收站" Margin="8,0,0,0" MinWidth="76" ToolTip="恢复或永久删除已移入回收站的会话，也可处理对应项目" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Split Panels Grid -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" MinWidth="250" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="520" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Projects Pane -->
                        <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.03" />
                            </Border.Effect>
                            <Grid Margin="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="86" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                        <TextBlock x:Name="ProjectPaneTitle" Text="选择对话所在项目" Foreground="{DynamicResource Ink}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock x:Name="ProjectPaneSubtitle" Text="可跨项目勾选要备份的主对话" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="ProjectScopeCombo" Style="{StaticResource ProjectConflictComboStyle}" Grid.Column="1" Width="106" Height="32" VerticalAlignment="Top" SelectedIndex="0" ToolTip="筛选全部项目或包含归档会话的项目">
                                            <ComboBoxItem Content="全部项目" Tag="all" />
                                            <ComboBoxItem Content="归档项目" Tag="archived" />
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel x:Name="ProjectSelectionTools" Grid.Row="1" Orientation="Horizontal" Margin="-8,7,0,0" Visibility="Collapsed">
                                        <Button x:Name="SelectAllProjectsButton" Style="{StaticResource TextButton}" Content="全选项目" Height="28" Padding="8,0" />
                                        <Button x:Name="ClearProjectsButton" Style="{StaticResource TextButton}" Content="清空" Height="28" Padding="8,0" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ProjectList" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ProjectItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsBatchSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="将完整项目、主对话和子代理对话一起加入备份">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource RoundCheckBox}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Project">
                                                                    <Setter Property="IsEnabled" Value="{Binding CanBackupFiles}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Cleanup">
                                                                    <Setter Property="IsEnabled" Value="{Binding CanCleanup}" />
                                                                    <Setter Property="ToolTip" Value="跨项目批量清理此项目的全部会话和目录" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Conversation">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ListMeta}" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding ArchivedSummary}" Foreground="#D97706" FontSize="10.8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" Foreground="{DynamicResource LineHover}" FontSize="18" VerticalAlignment="Center" Margin="9,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Right Sessions Pane -->
                        <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.03" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" MinHeight="126" />
                                    <RowDefinition Height="66" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="82" />
                                </Grid.RowDefinitions>

                                <!-- Project Hero Header -->
                                <Border MinHeight="126" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,13,20,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="ProjectTitleText" Text="选择一个项目" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="19" FontWeight="Bold" LineHeight="26" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource BadgeBackground}" CornerRadius="5" Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="项目路径" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="Medium" />
                                            </Border>
                                            <Border Grid.Column="1" Background="{DynamicResource PathBadgeBackground}" BorderBrush="{DynamicResource LineSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="ProjectPathText" Text="" Foreground="{DynamicResource PathBadgeForeground}" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </Border>
                                            <Button x:Name="CopyProjectPathButton" Grid.Column="2" Style="{StaticResource TextButton}" Content="复制路径" Height="28" Padding="10,0" Margin="8,0,0,0" />
                                        </Grid>
                                        <Grid Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ProjectMetaText" Text="" Foreground="{DynamicResource Muted}" FontSize="11.5" LineHeight="17" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            <Border Grid.Column="1" Width="1" Height="13" Background="{DynamicResource Line}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock x:Name="ProjectSizeText" Grid.Column="2" Text="项目文件：尚未统计" Foreground="{DynamicResource Muted}" FontSize="11.5" LineHeight="17" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                        </Grid>
                                        <TextBlock x:Name="SessionModeHint" Text="主对话和子代理对话已分开管理。" Foreground="{DynamicResource AccentDark}" FontSize="11.5" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Search & Selection Tool Bar -->
                                <Grid Grid.Row="1" Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="SearchBox" Style="{StaticResource RoundTextBox}" Height="36" Padding="34,1,11,1" ToolTip="搜索只筛选列表显示；全选和删除只处理当前显示结果" />
                                        <TextBlock Text="⌕" Foreground="{DynamicResource Faint}" FontSize="18" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        <TextBlock Text="筛选显示：标题、Thread ID 或路径" Foreground="{DynamicResource Faint}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                        <RadioButton x:Name="MainSessionsTabRadio" GroupName="SessionType" Style="{StaticResource ImportModeSegment}" Content="主对话" IsChecked="True" Height="36" MinWidth="82" Margin="0,0,4,0" />
                                        <RadioButton x:Name="SubagentSessionsTabRadio" GroupName="SessionType" Style="{StaticResource ImportModeSegment}" Content="子代理" Height="36" MinWidth="82" Margin="4,0,0,0" />
                                    </StackPanel>
                                    <StackPanel x:Name="SessionSelectionTools" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                                        <Button x:Name="ToggleSessionSelectionButton" Style="{StaticResource SecondaryButton}" Content="全选" Height="36" MinWidth="76" Padding="12,0" ToolTip="选择当前搜索结果中的全部对话；再次点击可全部取消" />
                                        <Button x:Name="DeleteSelectedSessionsButton" Style="{StaticResource SecondaryButton}" Content="删除所选" Height="36" MinWidth="106" Padding="12,0" Margin="8,0,0,0" Foreground="{DynamicResource DangerAccent}" BorderBrush="{DynamicResource DangerBorder}" IsEnabled="False" ToolTip="删除已勾选的对话；选中项目全部主对话后可同时处理项目目录" />
                                    </StackPanel>
                                </Grid>

                                <!-- Sessions List -->
                                <Grid Grid.Row="2" Margin="18,0,14,0">
                                    <ListBox x:Name="SessionList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SessionItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="SessionCard" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.03" />
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="120" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center" ToolTip="选择此对话：仅对话模式下用于备份，也可用于批量删除">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox" BasedOn="{StaticResource RoundCheckBox}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Conversation">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="Subagent">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,16,0">
                                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                            <WrapPanel Margin="0,5,0,0">
                                                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1" CornerRadius="5" Padding="7,2,7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding DisplayModel}" Foreground="{DynamicResource AccentDark}" FontSize="11" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas, Segoe UI Variable Text" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayModel}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border x:Name="SubagentRelationBorder" Background="{DynamicResource SubagentSoft}" BorderBrush="{DynamicResource SubagentBorder}" BorderThickness="1" CornerRadius="5" Padding="7,2,7,2" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                                                                    <TextBlock x:Name="SubagentRelationText" Text="{Binding DisplayRelation}" Foreground="{DynamicResource SubagentText}" FontSize="10.8" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayRelation}" />
                                                                </Border>
                                                                <Border x:Name="ArchivedStatusBorder" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="5" Padding="7,2,7,2" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                                                                    <TextBlock x:Name="ArchivedStatusText" Text="已归档" Foreground="#B45309" FontSize="10.8" FontWeight="Medium" VerticalAlignment="Center" />
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding DisplayMetadata}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayMetadata}" />
                                                            <Border Background="{DynamicResource PathBadgeBackground}" BorderBrush="{DynamicResource PathBadgeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayPath}" Foreground="{DynamicResource PathBadgeForeground}" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" VerticalAlignment="Center" FontSize="10.3" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayPath}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button x:Name="ViewSessionButton" Style="{StaticResource SessionActionButton}" Content="查看" CommandParameter="{Binding}" ToolTip="查看对话内容" />
                                                            <Button x:Name="DeleteSessionButton" Style="{StaticResource DangerActionButton}" Content="删除" CommandParameter="{Binding}" IsEnabled="{Binding CanDelete}" Margin="6,0,0,0" ToolTip="主对话可同时处理项目；删除存在后代的对话时会一并处理其子代理" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSubagent}" Value="True">
                                                        <Setter TargetName="SessionCard" Property="Background" Value="{DynamicResource SubagentSoft}" />
                                                        <Setter TargetName="SessionCard" Property="BorderBrush" Value="{DynamicResource SubagentBorder}" />
                                                        <Setter TargetName="SubagentRelationBorder" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Archived}" Value="True">
                                                        <Setter TargetName="ArchivedStatusBorder" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="SessionCard" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                        <Setter TargetName="SessionCard" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="EmptySessionsText" Text="没有符合条件的对话" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Grid>

                                <!-- Bottom Status & Action Bar -->
                                <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelMuted}" Padding="18,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="SelectedCountText" Text="已选 0 个主对话" Foreground="{DynamicResource Ink}" FontWeight="Bold" FontSize="14" />
                                            <TextBlock x:Name="SelectionHelpText" Text="生成 .codexchat：只包含勾选的主对话，不包含项目文件" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button x:Name="BackupSelectedButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="备份仅对话" MinWidth="148" Margin="10,0,0,0" ToolTip="生成 .codexchat；可跨多个项目，不包含项目目录" />
										<Button x:Name="BackupProjectFilesButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="备份项目＋对话" Margin="10,0,0,0" MinWidth="148" Visibility="Collapsed" ToolTip="生成 .codexproject；完整项目目录与全部对话进入同一个文件" />
                                        <Button x:Name="CleanupSelectedButton" Grid.Column="1" Style="{StaticResource DangerActionButton}" Content="批量清理所选项目" Height="38" MinWidth="148" Margin="10,0,0,0" Visibility="Collapsed" ToolTip="跨项目批量删除所选主对话、子代理和项目目录" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Import & Restore Page -->
                <Grid x:Name="ImportPage" Visibility="Collapsed" Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520" MinWidth="430" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="400" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.03" />
                        </Border.Effect>
                        <Grid x:Name="ImportWorkflowGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Margin="22,20,12,8" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,18">
                                <TextBlock Text="恢复到这台电脑" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="项目放到你选择的位置；对话仍由 C 盘 Codex 管理。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,18" />

                                <TextBlock Text="1 · 选择迁移包" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="PackagePathBox" Style="{StaticResource RoundTextBox}" />
                                    <Button x:Name="BrowsePackageButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="浏览…" Margin="9,0,0,0" MinWidth="78" />
                                </Grid>

                                <Border Margin="0,10,0,14" Padding="14,10" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock x:Name="PackageSummaryText" Text="等待选择迁移包" Foreground="#15803D" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock x:Name="PackageProjectText" Text="仅对话 .codexchat · 项目＋对话 .codexproject · 兼容旧版 .codexpack" Foreground="#166534" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="TargetPathLabel" Text="2 · 选择这台电脑上的项目目录" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TargetPathBox" Style="{StaticResource RoundTextBox}" />
                                    <Button x:Name="BrowseTargetButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="浏览…" Margin="9,0,0,0" MinWidth="78" />
                                </Grid>
                                <TextBlock x:Name="TargetPathHelpText" Text="目录可以与旧电脑不同，导入时会自动重写对话里的 cwd。" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="1,7,0,13" TextWrapping="Wrap" />

                                <CheckBox x:Name="MapPathCheck" Style="{StaticResource RoundCheckBox}" Content="把对话关联到上面的项目位置" IsChecked="True" />

								<Border x:Name="ProjectRestorePanel" Margin="0,12,0,0" Padding="14,12" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
									<StackPanel>
										<CheckBox x:Name="RestoreProjectFilesCheck" Style="{StaticResource RoundCheckBox}" Content="还原包内项目文件" IsChecked="True" />
										<TextBlock Text="目标目录已有文件时" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,10,0,5" />
										<ComboBox x:Name="ProjectConflictCombo" Style="{StaticResource ProjectConflictComboStyle}" SelectedIndex="0">
											<ComboBoxItem Content="要求目标目录为空（推荐）" Tag="require_empty" />
											<ComboBoxItem Content="保留现有同名文件，只补充缺失文件" Tag="skip" />
											<ComboBoxItem Content="覆盖同名文件（覆盖前自动备份）" Tag="overwrite" />
										</ComboBox>
										<TextBlock x:Name="ProjectRestoreHelpText" Text="项目文件将还原到上面的目录，会话仍导入 C 盘 Codex 目录。" Foreground="#92400E" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
									</StackPanel>
								</Border>

                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="1" MinHeight="164" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelMuted}" Padding="18,12,18,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="3 · 选择对话导入方式" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <RadioButton x:Name="MergeModeRadio" GroupName="ImportConflictMode" Style="{StaticResource ImportModeSegment}" Content="按原始编号合并" IsChecked="True" Margin="0,0,5,0" ToolTip="只在目标项目内按原始编号查找；找到后合并，首次迁入生成新编号" />
                                        <RadioButton x:Name="CopyModeRadio" Grid.Column="1" GroupName="ImportConflictMode" Style="{StaticResource ImportModeSegment}" Content="作为新对话复制" Margin="5,0,0,0" ToolTip="每次都生成全新编号和独立文件，删除一份不会影响另一份" />
                                    </Grid>
                                    <Border Margin="0,8,0,0" Padding="12,8" Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="8">
                                        <TextBlock x:Name="ImportModeHelpText" Text="推荐 · 按目标项目 + 原始编号识别同一对话；首次迁入生成新编号，以后仍能准确合并。" Foreground="#15803D" FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ImportActionBar" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,12" MinHeight="72">
                                <StackPanel>
                                    <TextBlock Text="推荐流程：先检查，通过后再导入。" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="1,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Button x:Name="InspectButton" Style="{StaticResource SecondaryButton}" Content="先检查（不写入）" Margin="0,0,6,0" Height="38" />
                                        <Button x:Name="ImportButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="开始导入" Margin="6,0,0,0" Height="38" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.03" />
                        </Border.Effect>
                        <Grid>
							<Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,0">
                                <Grid>
                                    <TextBlock Text="检查与导入记录" Foreground="{DynamicResource Ink}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4" CornerRadius="6" Background="{DynamicResource BadgeBackground}">
                                        <TextBlock Text="项目到所选位置 · 对话回 C 盘" Foreground="{DynamicResource Muted}" FontSize="11.5" />
                                    </Border>
                                </Grid>
                            </Border>
							<Border x:Name="ImportProgressPanel" Grid.Row="1" Visibility="Collapsed" Margin="18,14,18,0" Padding="14,12" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10">
								<Grid>
									<Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
									<Grid>
										<TextBlock x:Name="ImportStageText" Text="正在准备导入" Foreground="{DynamicResource AccentDark}" FontSize="13" FontWeight="SemiBold" />
										<TextBlock x:Name="ImportElapsedText" Text="00:00" HorizontalAlignment="Right" Foreground="#059669" FontSize="11.5" />
									</Grid>
									<TextBlock x:Name="ImportStageDetailText" Grid.Row="1" Text="界面仍可响应，请勿重复点击。" Foreground="#047857" FontSize="11.5" Margin="0,5,0,9" TextWrapping="Wrap" />
									<ProgressBar x:Name="ImportStageProgress" Grid.Row="2" IsIndeterminate="True" Height="4" Foreground="{DynamicResource Accent}" Background="#D1FAE5" BorderThickness="0" />
								</Grid>
							</Border>
							<TextBox x:Name="ImportLog" Grid.Row="2" Margin="18" Text="等待选择迁移包……" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Foreground="#374151" FontFamily="Cascadia Code, Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" Padding="2" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Status Bar -->
            <Border Grid.Row="3" Background="{DynamicResource WindowTitleBarBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="准备就绪" Foreground="{DynamicResource Muted}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Grid>
                    <ProgressBar x:Name="BusyProgress" Grid.Column="1" IsIndeterminate="True" Width="110" Height="3" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Background="#E5E7EB" BorderThickness="0" />
                </Grid>
            </Border>

            <!-- Conversation Preview Modal Overlay -->
            <Grid x:Name="ConversationOverlay" Grid.RowSpan="4" Panel.ZIndex="90" Background="#550F172A" Visibility="Collapsed">
                <Canvas x:Name="ConversationCanvas" ClipToBounds="True">
                    <Grid x:Name="ConversationDialogHost" Width="1180" Height="720" MinWidth="620" MinHeight="400">
                <Border x:Name="ConversationPanel" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.22" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="76" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="56" />
                        </Grid.RowDefinitions>

                        <!-- Preview Header -->
                        <Border x:Name="ConversationHeader" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0" Background="Transparent" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ConversationTitleText" Text="对话预览" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ConversationMetaText" Text="正在读取……" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ConversationMinimizeButton" Style="{StaticResource ChromeButton}" ToolTip="最小化到任务栏">
                                        <Border Width="12" Height="1.4" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" VerticalAlignment="Center" />
                                    </Button>
                                    <Button x:Name="ConversationCloseButton" Style="{StaticResource CloseButton}" ToolTip="关闭预览">
                                        <Grid Width="16" Height="16">
                                            <Line X1="2" Y1="2" X2="14" Y2="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.4" />
                                            <Line X1="14" Y1="2" X2="2" Y2="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.4" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Preview Chat Stream -->
                        <Grid x:Name="ConversationContentLayout" Grid.Row="1" Margin="18,12,18,0" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ConversationNavigationHost" Width="38" Margin="2,4,8,4" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" Visibility="Collapsed" AutomationProperties.Name="用户消息导航">
                                <ScrollViewer x:Name="ConversationNavigationScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" CanContentScroll="False" PanningMode="VerticalOnly" Focusable="False">
                                    <ScrollViewer.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.03" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.97" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </ScrollViewer.OpacityMask>
                                    <StackPanel x:Name="ConversationNavigationRail" Width="36" Background="Transparent" />
                                </ScrollViewer>
                            </Border>
                            <ListBox x:Name="ConversationList" Grid.Column="1" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,12" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="MessageBubble" HorizontalAlignment="Left" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="16,12">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.03" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <Grid Margin="1,0,1,7">
                                                <TextBlock x:Name="RoleLabel" Text="{Binding RoleLabel}" Foreground="{DynamicResource AccentDark}" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DisplayTime}" HorizontalAlignment="Right" Foreground="{DynamicResource Faint}" FontSize="10.5" Margin="46,0,0,0" />
                                            </Grid>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13" IsTabStop="False" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                            <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="MessageBubble" Property="Background" Value="{DynamicResource AccentSoft}" />
                                            <Setter TargetName="MessageBubble" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
                                            <Setter TargetName="RoleLabel" Property="Foreground" Value="{DynamicResource AccentDark}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNotice}" Value="True">
                                            <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Center" />
                                            <Setter TargetName="MessageBubble" Property="Background" Value="#F1F5F9" />
                                            <Setter TargetName="MessageBubble" Property="BorderBrush" Value="#E2E8F0" />
                                            <Setter TargetName="RoleLabel" Property="Foreground" Value="{DynamicResource Muted}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>
                            <Popup x:Name="ConversationNavigationPreviewPopup" AllowsTransparency="True" Placement="Right" PopupAnimation="Fade" StaysOpen="True" Focusable="False">
                                <Border Width="320" MaxHeight="122" Margin="10,0,12,0" Padding="12,10" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.12" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock x:Name="ConversationNavigationPreviewTitle" Foreground="{DynamicResource Ink}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ConversationNavigationPreviewResponse" Margin="0,5,0,0" Foreground="{DynamicResource Muted}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Preview Footer -->
                        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,0" Background="{DynamicResource PanelMuted}">
                            <Grid>
                                <TextBlock Text="只读预览，不会修改原会话" Foreground="{DynamicResource Muted}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,126,0" />
                                <Button x:Name="CopyThreadIdButton" Style="{StaticResource SecondaryButton}" Content="复制 Thread ID" HorizontalAlignment="Right" VerticalAlignment="Center" Height="34" MinWidth="112" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                    </Grid>
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</Window>
